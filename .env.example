PORT=3000
# Persistent storage directory. On many hosts, attach a persistent disk and set DATA_DIR to it.
DATA_DIR=./data

# Email notifications to the clinic. Configure a provider's SMTP credentials.
CLINIC_EMAIL=devspeechandhearingclinic01@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=DEV Clinic Website <your-sending-gmail-address@gmail.com>

# Optional real AI replies. Without this, a built-in clinic FAQ assistant responds.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Generate a long random token before deployment. Never put this in frontend files.
ADMIN_TOKEN=replace-with-a-long-random-secret
